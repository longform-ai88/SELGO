# Base app URL used in redirects
APP_BASE_URL=https://selga.no

# Vipps Login (OIDC)
VIPPS_ENV=sandbox
VIPPS_CLIENT_ID=your_vipps_client_id
VIPPS_CLIENT_SECRET=your_vipps_client_secret
VIPPS_LOGIN_DISCOVERY_URL=https://apitest.vipps.no/access-management-1.0/access/.well-known/openid-configuration
VIPPS_REDIRECT_URI=https://selga.no/auth/vipps/callback
VIPPS_LOGIN_SCOPE=openid name phoneNumber
VIPPS_LOGIN_SUCCESS_REDIRECT=/app

# Vipps ePayment
VIPPS_MERCHANT_SERIAL_NUMBER=your_msn
VIPPS_SUBSCRIPTION_KEY=your_subscription_key_if_required
VIPPS_EPAYMENT_API_BASE=https://apitest.vipps.no
VIPPS_PAYMENT_SCOPE=ePayment
VIPPS_PAYMENT_RETURN_URL=https://selga.no/vipps/return
VIPPS_WEBHOOK_SECRET=your_webhook_signature_secret

# Identification headers sent to Vipps
VIPPS_SYSTEM_NAME=selga-backend
VIPPS_SYSTEM_VERSION=1.0.0
VIPPS_SYSTEM_PLUGIN_NAME=selga
VIPPS_SYSTEM_PLUGIN_VERSION=1.0.0

# Existing app values
INVITE_CODE=
DATABASE_URL=sqlite:///./selga.db
STRIPE_SECRET_KEY=
